<?xml version="1.0" encoding="utf-8"?>
<!-- Test APK for AndroidAssetBackend: a NativeActivity with no Java code. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.vfs.assettest" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35"/>
    <application android:label="VFS Asset Test" android:hasCode="false" android:debuggable="true"
                 android:extractNativeLibs="false">
        <activity android:name="android.app.NativeActivity" android:exported="true"
                  android:configChanges="orientation|keyboardHidden|screenSize">
            <meta-data android:name="android.app.lib_name" android:value="vfsassettest"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
