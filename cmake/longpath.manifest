<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Declare long-path support: when the system has LongPathsEnabled, Win32 calls without a \\?\ prefix can also exceed MAX_PATH.
     VFS native path conversion already adds the \\?\ prefix; this manifest only lets other code in the process (third-party libraries, the standard library) benefit as well. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings xmlns:ws2="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
      <ws2:longPathAware>true</ws2:longPathAware>
    </windowsSettings>
  </application>
</assembly>
